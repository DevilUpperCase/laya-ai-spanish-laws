            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_v1_documents_post"
      },
      "CoverageReport": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "blocked",
              "verified"
            ],
            "title": "Status",
            "default": "blocked"
          },
          "required_inventory_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Inventory Revision"
          },
          "total_jurisdictions": {
            "type": "integer",
            "title": "Total Jurisdictions",
            "default": 0
          },
          "verified_jurisdictions": {
            "type": "integer",
            "title": "Verified Jurisdictions",
            "default": 0
          },
          "legal_instruments": {
            "type": "integer",
            "title": "Legal Instruments",
            "default": 0
          },
          "section_versions": {
            "type": "integer",
            "title": "Section Versions",
            "default": 0
          },
          "embedded_chunks": {
            "type": "integer",
            "title": "Embedded Chunks",
            "default": 0
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks",
            "default": 0
          },
          "missing_jurisdictions": {
            "type": "integer",
            "title": "Missing Jurisdictions",
            "default": 0
          },
          "sources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Sources"
          },
          "gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gaps"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CoverageReport"
      },
      "DocumentPage": {
        "properties": {
          "page_number": {
            "type": "integer",
            "title": "Page Number"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "ocr_uncertain": {
            "type": "boolean",
            "title": "Ocr Uncertain",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
