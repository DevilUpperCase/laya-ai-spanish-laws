        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "filename",
          "parse_status",
          "mime_type",
          "created_at"
        ],
        "title": "DocumentRecord"
      },
      "DocumentSelection": {
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Number"
          },
          "start_offset": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Offset"
          },
          "end_offset": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End Offset"
          },
          "selected_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000
              },
              {
                "type": "null"
              }
