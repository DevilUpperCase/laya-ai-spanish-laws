          "text"
        ],
        "title": "DocumentPage"
      },
      "DocumentRecord": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "title": "Tenant Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "parse_status": {
            "type": "string",
            "title": "Parse Status"
          },
          "mime_type": {
            "type": "string",
            "title": "Mime Type"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/DocumentPage"
            },
            "type": "array",
            "title": "Pages"
          },
          "failure_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
