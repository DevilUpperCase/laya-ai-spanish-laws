# Application configuration. setup_docker.py writes ignored development secrets.
# Production still requires reviewed TLS/auth/storage/scanner/backup operations.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
SUPABASE_AUTH_URL=http://127.0.0.1:9999
BROWSER_SESSION_SECONDS=3600
DATABASE_URL=
ADMIN_DATABASE_URL=
INGEST_DATABASE_URL=
WORKER_DATABASE_URL=
INTERNAL_API_KEY=
STORAGE_INTERNAL_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PRIVATE_BUCKET=client-private
PUBLIC_ORIGINALS_BUCKET=legal-originals
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
SEARCH_CHECKPOINTS_ENABLED=false
LAYA_BASE_URL=http://127.0.0.1:8001
LAYA_API_KEY=
LAYA_MODELS=multilingual
LAYA_DEFAULT_MODEL=multilingual
LAYA_PRELOAD=1
LAYA_JEV_STRICT=0
# Application config, not upstream laya-serve config:
LAYA_MODE=shadow
LAYA_RERANK_ENABLED=false
LAYA_MODEL_REVISION=
LAYA_TIMEOUT_SECONDS=2
SEARCH_SQL_TIMEOUT_SECONDS=30
LAYA_MAX_RETRIES=1
LAYA_CIRCUIT_FAILURES=5
LAYA_CIRCUIT_OPEN_SECONDS=30
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=
EMBEDDING_MODEL_PATH=./model-cache/bge-m3
PRIVATE_STORAGE_PATH=./private-data/objects
DELETION_JOURNAL_PATH=./private-data/deletion-journal
CLAMAV_HOST=
CLAMAV_PORT=3310
OCR_ENABLED=false
OCR_LANGUAGE=spa+cat+eus+glg
OCR_DATA_PATH=./model-cache/ocr
OCR_MODEL_REVISION=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_THREADS=4
EMBEDDING_BATCH_SIZE=8
DOCUMENT_RETENTION_MODE=until_tenant_deletion
LIVE_PURGE_DEADLINE_HOURS=24
BACKUP_MAX_AGE_DAYS=30
DOWNLOAD_LINK_MAX_SECONDS=60
INGEST_RECONCILIATION_DAYS=7
# Freeze a reviewed threshold file after pilot; never substitute arbitrary defaults.
EVALUATION_THRESHOLDS_PATH=
