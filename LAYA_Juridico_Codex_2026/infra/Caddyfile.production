# Replace LAYA_DOMAIN through the deployment environment; keep upstream loopback.
# A publicly trusted certificate requires ownership/DNS for the real domain.
{
 admin off
}
{$LAYA_DOMAIN} {
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  Referrer-Policy same-origin
  -Server
 }
 reverse_proxy 127.0.0.1:3000
}
